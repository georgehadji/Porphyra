# Astro (via Vite) loads .env from THIS directory, not the monorepo root —
# hence a separate file here instead of relying on the root .env.example.
# PUBLIC_ prefix is required for any var the client-side script needs to read.

# Leave both blank in local dev — Base.astro skips the analytics script
# entirely when either is unset, rather than pointing at a placeholder.
PUBLIC_UMAMI_URL=
PUBLIC_UMAMI_WEBSITE_ID=

# Where the waitlist form POSTs — the SaaS app's domain, since apps/web has
# no server runtime to handle the submission itself (see the plan's "Why two
# frameworks"). Point this at the app's local dev server for local testing.
PUBLIC_APP_ORIGIN=http://localhost:3000
