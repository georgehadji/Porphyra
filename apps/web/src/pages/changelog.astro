---
import Base from "../layouts/Base.astro";

const entries = [
  {
    version: "0.1.0",
    date: "2026-08-07",
    title: "Building in public",
    items: [
      "Marketing site and waitlist live.",
      "Encryption architecture designed and implemented — client-side E2EE vault, consented AI evaluation.",
      "Core scoring, legitimacy, and pipeline-state logic built and tested.",
    ],
  },
];
---

<Base title="Changelog" description="What's shipped, in order.">
  <main class="page">
    <header class="page-header">
      <h1>Changelog</h1>
      <p>What's actually shipped — not a roadmap.</p>
    </header>

    <ol class="entries">
      {entries.map((e) => (
        <li>
          <div class="entry-meta">
            <span class="entry-version">v{e.version}</span>
            <time datetime={e.date}>{e.date}</time>
          </div>
          <h2>{e.title}</h2>
          <ul>{e.items.map((i) => <li>{i}</li>)}</ul>
        </li>
      ))}
    </ol>
  </main>
</Base>

<style>
  .page { max-width: 40rem; margin: 0 auto; padding: var(--p-space-16) var(--p-space-6); }
  .page-header { margin-bottom: var(--p-space-10); }
  .page-header h1 { font-family: var(--p-font-display); font-size: var(--p-text-5xl); color: var(--p-porphyra-900); margin: 0 0 var(--p-space-2); }
  .page-header p { color: var(--color-muted); font-size: var(--p-text-lg); }
  .entries { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--p-space-10); }
  .entries > li { border-left: 2px solid var(--color-border); padding-left: var(--p-space-5); }
  .entry-meta { display: flex; align-items: center; gap: var(--p-space-3); margin-bottom: var(--p-space-2); }
  .entry-version { font-family: var(--p-font-mono); font-size: var(--p-text-sm); background: var(--color-brand-soft); color: var(--color-brand-text); padding: 2px var(--p-space-2); border-radius: var(--p-radius-sm); }
  time { font-size: var(--p-text-sm); color: var(--color-faint); }
  h2 { font-size: var(--p-text-xl); margin: 0 0 var(--p-space-3); }
  .entries ul { margin: 0; padding-left: var(--p-space-5); color: var(--color-muted); display: flex; flex-direction: column; gap: var(--p-space-1); }
</style>
