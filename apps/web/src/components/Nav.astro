---
// Primary CTA is the waitlist, not "Sign up" — apps/app doesn't have real
// accounts until Phase 2 lands. Swap this to /signup on the app's domain
// once auth exists; grep for WAITLIST_CTA to find every place this decision
// is baked in.
const links = [
  { href: "/how-it-works", label: "How it works" },
  { href: "/pricing", label: "Pricing" },
  { href: "/security", label: "Security" },
  { href: "/about", label: "About" },
];
---

<header class="nav">
  <div class="nav__inner">
    <a href="/" class="nav__brand" aria-label="Porphyra home">
      <svg width="24" height="24" viewBox="0 0 32 32" aria-hidden="true">
        <circle cx="16" cy="16" r="16" fill="var(--color-brand)"/>
        <path d="M16 24c-4.4 0-8-3.6-8-8s3.6-8 8-8c3.3 0 6 2.7 6 6s-2.2 5-5 5c-2.2 0-4-1.8-4-4s1.3-3.3 3-3.3"
              fill="none" stroke="var(--p-neutral-0)" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
      <span>Porphyra</span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav__links">
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <a href="/#waitlist" class="nav__cta">Get early access</a>
  </div>
</header>

<style>
  .nav {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-background);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .nav__inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--p-space-4) var(--p-space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--p-space-6);
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--p-space-2);
    font-family: var(--p-font-display);
    font-size: var(--p-text-xl);
    font-weight: 600;
    color: var(--p-porphyra-900);
    text-decoration: none;
  }
  .nav__links {
    display: flex;
    gap: var(--p-space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__links a {
    color: var(--color-muted);
    text-decoration: none;
    font-size: var(--p-text-sm);
    font-weight: 500;
  }
  .nav__links a:hover {
    color: var(--color-foreground);
  }
  .nav__cta {
    background: var(--button-primary-bg);
    color: var(--button-primary-fg);
    padding: var(--p-space-2) var(--p-space-4);
    border-radius: var(--button-radius);
    text-decoration: none;
    font-size: var(--p-text-sm);
    font-weight: 600;
    white-space: nowrap;
  }
  .nav__cta:hover {
    background: var(--button-primary-bg-hover);
  }
  @media (max-width: 640px) {
    .nav__links {
      display: none;
    }
  }
</style>
