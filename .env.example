# Copy to .env and fill in real values. Never commit .env.
# See infra/README.md for the full provisioning + secrets-management runbook.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
MARKETING_URL=http://localhost:4321

# --- Database ---
DATABASE_URL=postgres://porphyra:porphyra@localhost:5432/porphyra
DATABASE_URL_READONLY=

# --- Redis (sessions, rate limiting, AI job queue) ---
REDIS_URL=redis://localhost:6379

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Crypto ---
# No server-side encryption or blind-index key belongs here — that would defeat
# E2EE. The Master Key, Data Encryption Key, and the blind-index key derived
# from it (see packages/crypto) exist ONLY client-side. This section is
# intentionally empty; see docs/SECURITY.md once Phase 2 lands.

# --- AI provider (platform-paid by default; see packages/ai) ---
ANTHROPIC_API_KEY=
AI_DEFAULT_PROVIDER=anthropic

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=

# --- Analytics ---
UMAMI_URL=
UMAMI_WEBSITE_ID=

# --- Email (transactional: verification, password reset, recovery-key reminder) ---
RESEND_API_KEY=
EMAIL_FROM=noreply@porphyra.example
