{
  "name": "porphyra",
  "version": "0.1.0",
  "private": true,
  "description": "Porphyra — a job-search platform that scores judgement, not volume.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "security": "pnpm run security:audit && pnpm run security:secrets",
    "security:audit": "pnpm audit --prod",
    "security:secrets": "gitleaks detect --no-git -v",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.0.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.0",
    "typescript": "~5.9.0"
  }
}
